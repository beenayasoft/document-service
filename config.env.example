# Configuration Document Service

# Django Settings
SECRET_KEY=django-insecure-document-service-dev-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,document-service

# Database PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=documents
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379/1

# API Configuration
API_PORT=8003
API_HOST=0.0.0.0

# CORS (pour développement)
CORS_ALLOW_ALL_ORIGINS=True

# Logging Level
LOG_LEVEL=DEBUG 